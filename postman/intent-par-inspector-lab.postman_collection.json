            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().state).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
