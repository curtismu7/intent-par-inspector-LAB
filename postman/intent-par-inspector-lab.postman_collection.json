    {
      "name": "PAR endpoint (RFC 9126 + intent rule)",
      "description": "POST /as/par with Basic client auth. The mock clients are agent-app / partner-app / legacy-web with throwaway secrets. The intent must be a JSON object with action, resource, amount, currency, subject.",
      "item": [
        {
          "name": "PAR with a valid intent",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Pre-request */",
                  "pm.collectionVariables.set('AGENT_BASIC', Buffer.from('agent-app:mock-secret-agent-app').toString('base64'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PAR with a valid intent\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  const b = pm.response.json(); pm.expect(b.request_uri).to.include('urn:ietf:params:oauth:request_uri');",
                  "  pm.expect(b.expires_in).to.eql(60);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{AGENT_BASIC}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://agent.example.invalid/callback"
                },
                {
                  "key": "scope",
                  "value": "mcp:read"
                },
                {
                  "key": "state",
                  "value": "s1"
                },
                {
                  "key": "code_challenge",
                  "value": "abc"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                },
                {
                  "key": "intent",
                  "value": "{\"action\":\"book\",\"resource\":\"plane ticket SEA-JFK\",\"amount\":420,\"currency\":\"USD\",\"subject\":\"Mark\"}"
                }
              ]
            },
            "url": {
              "raw": "{{LAB_BASE}}/as/par",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "as",
                "par"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "PAR with an unknown client (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PAR with an unknown client (negative)\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
                  "  pm.expect(pm.response.json().reason).to.eql('client_auth_failed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "nope"
                },
                {
                  "key": "response_type",
                  "value": "code"
                }
              ]
            },
            "url": {
              "raw": "{{LAB_BASE}}/as/par",
              "host": [
                "{{LAB_BASE}}"
